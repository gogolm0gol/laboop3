<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JsonDispatcher.AboutPage"
             Title="Про програму">
    <VerticalStackLayout Padding="24" Spacing="10" MaximumWidthRequest="560">
        <Label Text="Диспетчер JSON — «Бібліотека: книги»" FontSize="20" FontAttributes="Bold" />
        <Label Text="ПІБ: Прізвище Ім'я По батькові" />
        <Label Text="Курс: 2" />
        <Label Text="Група: XX-00" />
        <Label Text="Рік: 2026" />
        <Label Text="Опис: програма відкриває JSON-файл, показує дані в таблиці (Grid), дозволяє додавати, редагувати та видаляти записи, шукати за кількома критеріями (LINQ) і зберігати зміни у файл." />
        <Button Text="Закрити" Clicked="OnClose" HorizontalOptions="Start" />
    </VerticalStackLayout>
</ContentPage>
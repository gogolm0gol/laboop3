<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="JsonDispatcher.BookPage"
             Title="Книга">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="110,*"
          Padding="20" RowSpacing="10" ColumnSpacing="10" MaximumWidthRequest="520">
        <Label Grid.Row="0" Text="Назва:"      VerticalOptions="Center" />
        <Entry Grid.Row="0" Grid.Column="1" x:Name="TitleEntry" />
        <Label Grid.Row="1" Text="Автор:"      VerticalOptions="Center" />
        <Entry Grid.Row="1" Grid.Column="1" x:Name="AuthorEntry" />
        <Label Grid.Row="2" Text="Рік:"        VerticalOptions="Center" />
        <Entry Grid.Row="2" Grid.Column="1" x:Name="YearEntry" Keyboard="Numeric" />
        <Label Grid.Row="3" Text="Жанр:"       VerticalOptions="Center" />
        <Entry Grid.Row="3" Grid.Column="1" x:Name="GenreEntry" />
        <Label Grid.Row="4" Text="Ціна, грн:"  VerticalOptions="Center" />
        <Entry Grid.Row="4" Grid.Column="1" x:Name="PriceEntry" Keyboard="Numeric" />
        <Label Grid.Row="5" Text="В наявності:" VerticalOptions="Center" />
        <Switch Grid.Row="5" Grid.Column="1" x:Name="AvailableSwitch" IsToggled="True" HorizontalOptions="Start" />
        <HorizontalStackLayout Grid.Row="6" Grid.ColumnSpan="2" Spacing="10" HorizontalOptions="End">
            <Button Text="OK"        Clicked="OnOk" />
            <Button Text="Скасувати" Clicked="OnCancel" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
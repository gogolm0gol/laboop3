<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:JsonDispatcher.Models"
             x:Class="JsonDispatcher.MainPage"
             Title="Диспетчер JSON — Бібліотека">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Відкрити"     Clicked="OnOpen" />
        <ToolbarItem Text="Зберегти"     Clicked="OnSave" />
        <ToolbarItem Text="Зберегти як…" Clicked="OnSaveAs" />
        <ToolbarItem Text="Про програму" Clicked="OnAbout" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="10" RowSpacing="8">

        <Label x:Name="PathLabel" Grid.Row="0" Text="Файл не відкрито" FontAttributes="Italic" />

        <Grid Grid.Row="1" ColumnDefinitions="2*,*,90,90,Auto,Auto" ColumnSpacing="6">
            <Entry  x:Name="SearchText"  Grid.Column="0" Placeholder="Пошук: автор або назва" TextChanged="OnFilterChanged" />
            <Picker x:Name="GenrePicker" Grid.Column="1" Title="Жанр" SelectedIndexChanged="OnFilterChanged" />
            <Entry  x:Name="YearFrom"    Grid.Column="2" Placeholder="Рік від" Keyboard="Numeric" TextChanged="OnFilterChanged" />
            <Entry  x:Name="YearTo"      Grid.Column="3" Placeholder="Рік до"  Keyboard="Numeric" TextChanged="OnFilterChanged" />
            <HorizontalStackLayout Grid.Column="4" VerticalOptions="Center">
                <CheckBox x:Name="OnlyAvailable" CheckedChanged="OnFilterChanged" />
                <Label Text="В наявності" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Grid.Column="5" Text="Скинути" Clicked="OnResetFilter" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="50,2*,1.5*,60,*,90,100" Padding="4,6"
              BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}">
            <Label Grid.Column="0" Text="№"       FontAttributes="Bold" />
            <Label Grid.Column="1" Text="Назва"   FontAttributes="Bold" />
            <Label Grid.Column="2" Text="Автор"   FontAttributes="Bold" />
            <Label Grid.Column="3" Text="Рік"     FontAttributes="Bold" />
            <Label Grid.Column="4" Text="Жанр"    FontAttributes="Bold" />
            <Label Grid.Column="5" Text="Ціна, грн" FontAttributes="Bold" />
            <Label Grid.Column="6" Text="Наявність" FontAttributes="Bold" />
        </Grid>

        <CollectionView x:Name="BooksView" Grid.Row="3" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Grid ColumnDefinitions="50,2*,1.5*,60,*,90,100" Padding="4,6">
                        <Label Grid.Column="0" Text="{Binding Id}" />
                        <Label Grid.Column="1" Text="{Binding Title}" />
                        <Label Grid.Column="2" Text="{Binding Author}" />
                        <Label Grid.Column="3" Text="{Binding Year}" />
                        <Label Grid.Column="4" Text="{Binding Genre}" />
                        <Label Grid.Column="5" Text="{Binding Price, StringFormat='{0:F2}'}" />
                        <CheckBox Grid.Column="6" IsChecked="{Binding Available, Mode=OneWay}" IsEnabled="False" HorizontalOptions="Start" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="4" Spacing="8">
            <Button Text="Додати"      Clicked="OnAdd" />
            <Button Text="Редагувати"  Clicked="OnEdit" />
            <Button Text="Видалити"    Clicked="OnDelete" />
            <Label x:Name="CountLabel" VerticalOptions="Center" Margin="16,0,0,0" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>